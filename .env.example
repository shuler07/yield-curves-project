# Local development only. Change the example password before starting PostgreSQL.
POSTGRES_DB=yield_curves
POSTGRES_USER=yield_curves
POSTGRES_PASSWORD=change_me_local
POSTGRES_PORT=5433
# Keep credentials in this URL in sync with the settings above.
# URL-encode special characters in the password.
DATABASE_URL=postgresql+psycopg://yield_curves:change_me_local@localhost:5433/yield_curves
TEST_DATABASE_URL=postgresql+psycopg://yield_curves:change_me_local@localhost:5433/yield_curves

# The API starts one background ETL worker; disable it for read-only instances.
ETL_SCHEDULER_ENABLED=true
ETL_INTERVAL_HOURS=6
ETL_TIMEOUT_SECONDS=180
